{
  "entities": {
    "Match": {
      "title": "Match",
      "description": "A live or scheduled match document containing metadata, team configurations, scoreboard totals, and game clock state.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the match operator.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Display title of the match.",
          "minLength": 1,
          "maxLength": 120
        },
        "competition": {
          "type": "string",
          "description": "Competition or league name.",
          "maxLength": 120
        },
        "venue": {
          "type": "string",
          "description": "Match venue or stadium.",
          "maxLength": 120
        },
        "matchDate": {
          "type": "string",
          "description": "Match date in YYYY-MM-DD format.",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "halfDurationMinutes": {
          "type": "integer",
          "description": "Duration of a single match half in minutes."
        },
        "homeTeam": {
          "type": "object",
          "description": "Home team name, short code, and kit color."
        },
        "awayTeam": {
          "type": "object",
          "description": "Away team name, short code, and kit color."
        },
        "clock": {
          "type": "object",
          "description": "Live game clock state including elapsedSeconds, isRunning, period, addedMinutes, and lastTickAt."
        },
        "homeScore": {
          "type": "integer",
          "description": "Current home team score."
        },
        "awayScore": {
          "type": "integer",
          "description": "Current away team score."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "ownerId",
        "title",
        "competition",
        "venue",
        "matchDate",
        "halfDurationMinutes",
        "homeTeam",
        "awayTeam",
        "clock",
        "homeScore",
        "awayScore",
        "createdAt",
        "updatedAt"
      ]
    },
    "Player": {
      "title": "Player",
      "description": "A squad player belonging to either the home or away lineup for a specific match.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the match operator.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "team": {
          "type": "string",
          "enum": ["HOME", "AWAY"],
          "description": "Team side for the player."
        },
        "number": {
          "type": "integer",
          "description": "Jersey number between 1 and 99."
        },
        "name": {
          "type": "string",
          "description": "Player full name.",
          "minLength": 1,
          "maxLength": 80
        },
        "position": {
          "type": "string",
          "enum": ["GK", "DEF", "MID", "FWD"],
          "description": "Field position."
        },
        "isStarter": {
          "type": "boolean",
          "description": "Whether the player starts the match."
        },
        "status": {
          "type": "string",
          "enum": ["ON_PITCH", "BENCH", "SUBBED_OFF"],
          "description": "Current pitch status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "ownerId",
        "team",
        "number",
        "name",
        "position",
        "isStarter",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "MatchEvent": {
      "title": "MatchEvent",
      "description": "A chronological match event such as a goal, card, substitution, or match note.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the match operator.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "GOAL",
            "YELLOW_CARD",
            "RED_CARD",
            "SUBSTITUTION",
            "KICKOFF",
            "HALF_TIME",
            "FULL_TIME",
            "NOTE"
          ],
          "description": "Event category."
        },
        "team": {
          "type": "string",
          "enum": ["HOME", "AWAY", "MATCH"],
          "description": "Team associated with the event, or MATCH for match-wide events."
        },
        "minute": {
          "type": "integer",
          "description": "Match minute (0 to 180)."
        },
        "addedMinute": {
          "type": "integer",
          "description": "Stoppage time added minute (0 to 45)."
        },
        "clockDisplay": {
          "type": "string",
          "description": "Formatted clock MM:SS string at the moment of the event.",
          "maxLength": 16
        },
        "period": {
          "type": "string",
          "enum": [
            "PRE_MATCH",
            "FIRST_HALF",
            "HALF_TIME",
            "SECOND_HALF",
            "EXTRA_TIME_1",
            "EXTRA_TIME_2",
            "FULL_TIME"
          ],
          "description": "Active match period when event occurred."
        },
        "playerId": {
          "type": "string",
          "description": "Primary player document ID if selected from lineup.",
          "maxLength": 128
        },
        "playerName": {
          "type": "string",
          "description": "Primary player display name.",
          "maxLength": 80
        },
        "secondaryPlayerId": {
          "type": "string",
          "description": "Secondary player document ID (assist or substitute in).",
          "maxLength": 128
        },
        "secondaryPlayerName": {
          "type": "string",
          "description": "Secondary player display name.",
          "maxLength": 80
        },
        "goalType": {
          "type": "string",
          "description": "Goal classification if type is GOAL.",
          "maxLength": 32
        },
        "note": {
          "type": "string",
          "description": "Optional event notes.",
          "maxLength": 200
        },
        "clientCreatedIso": {
          "type": "string",
          "description": "ISO timestamp for stable client sorting.",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "ownerId",
        "type",
        "team",
        "minute",
        "addedMinute",
        "clockDisplay",
        "period",
        "playerId",
        "playerName",
        "secondaryPlayerId",
        "secondaryPlayerName",
        "goalType",
        "note",
        "clientCreatedIso",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Top-level match documents owned by the authenticated match operator."
    },
    "/matches/{matchId}/players/{playerId}": {
      "schema": { "$ref": "#/entities/Player" },
      "description": "Home and away squad players for a specific match."
    },
    "/matches/{matchId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/MatchEvent" },
      "description": "Chronological match events (goals, scorers, cards, substitutions, notes) for a specific match."
    }
  }
}
